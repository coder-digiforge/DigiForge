# Neon pooled connection string (Vercel + local)
DATABASE_URL=

# Session / auth — REQUIRED in production (HMAC for signed cookies, min 16 chars)
NEON_AUTH_COOKIE_SECRET=

# First admin when ALLOW_DEMO_SEED=false (production empty bootstrap)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Admin

# Crypto payments — NOWPayments (REQUIRED in production)
CRYPTOPAY_API_KEY=
CRYPTOPAY_IPN_SECRET=
# Optional override; default https://api.nowpayments.io/v1
CRYPTOPAY_API_BASE=

# Email verification via Resend (REQUIRED in production)
RESEND_API_KEY=
EMAIL_FROM=DigiForge <noreply@yourdomain.com>

# Demo only — must stay false in production
ALLOW_DEMO_DEPOSIT_AUTOCONFIRM=false
ALLOW_DEMO_SEED=false

# Store backend: json | relational (production defaults to relational)
STORE_MODE=relational

# Public app URL (webhooks / email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron jobs — Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Skip startup readiness throw (emergency only)
# SKIP_READINESS_CHECK=true
