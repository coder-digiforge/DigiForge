# Neon pooled connection string (Vercel + local)
DATABASE_URL=

# Session / auth
NEON_AUTH_COOKIE_SECRET=

# Crypto payments (OxaPay / NOWPayments style IPN)
CRYPTOPAY_API_KEY=
# REQUIRED in production for /api/crypto/webhook (HMAC secret)
CRYPTOPAY_IPN_SECRET=

# Demo only: auto-confirm deposits without webhook.
# In production defaults to false. Set "true" only for local demos.
ALLOW_DEMO_DEPOSIT_AUTOCONFIRM=

NEXT_PUBLIC_APP_URL=http://localhost:3000
