{
  "name": "digiforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:schema": "node scripts/apply-schema.mjs",
    "db:alter": "node scripts/alter-schema.mjs",
    "db:migrate": "node scripts/migrate-to-relational.mjs",
    "db:setup": "npm run db:schema && npm run db:alter && npm run db:migrate",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "ready": "node scripts/check-ready.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "lucide-react": "^1.73.0",
    "nanoid": "^6.0.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
